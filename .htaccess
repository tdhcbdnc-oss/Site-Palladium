# Конфигурация Apache/LiteSpeed для хостинга Timeweb.
# На GitHub Pages этот файл игнорируется — там всё перечисленное делалось само.
# Порядок правил важен: сначала www→апекс, потом HTTP→HTTPS, иначе будет двойной редирект.

# ---------------------------------------------------------------- 404
# Иначе посетитель на битой ссылке увидит стандартную страницу хостинга.
ErrorDocument 404 /404.html

# ---------------------------------------------------------------- редиректы
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.palladium.com.ru → palladium.com.ru (одним прыжком, сразу на https)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # http → https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------- кодировка
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/xml .xml
</IfModule>

# ---------------------------------------------------------------- сжатие
# Страницы весят 370–450 КБ (дизайн-система и шрифты вшиты внутрь),
# на gzip они ужимаются в разы — для мобильного интернета это заметно.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------- кеширование
# Картинки не меняются — держим долго. HTML короткой жизнью,
# чтобы правки доезжали до посетителей быстро.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/html               "access plus 10 minutes"
</IfModule>

# ---------------------------------------------------------------- служебное
# Не отдавать наружу сборщик и исходники — на сайте они не нужны.
<IfModule mod_rewrite.c>
  RewriteRule ^build/ - [F,L]
</IfModule>

# Не показывать список файлов, если в папке нет index.html
Options -Indexes
